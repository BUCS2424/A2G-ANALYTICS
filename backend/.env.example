APP_NAME=A2G Analytics
APP_URL=http://a2ganalytics.localhost:5173
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=true

# Local dev: MongoDB running in the a2g-mongo Docker container on port 27018
# (kept off 27017 to avoid colliding with other local Mongo instances).
MONGODB_URI=mongodb://127.0.0.1:27018
MONGODB_DB=a2g_analytics

GEOIP_DB_PATH=geoip/GeoLite2-City.mmdb
